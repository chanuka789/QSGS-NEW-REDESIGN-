# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://qs-global-solutions.com

# ─────────────────────────────────────────────────────────────
# Email (Microsoft 365)
# MAIL_PROVIDER: graph (recommended) | smtp | console (dev only: prints emails to the log)
# ─────────────────────────────────────────────────────────────
MAIL_PROVIDER=graph
MAIL_FROM=info@qs-global-solutions.com          # mailbox that sends the emails
MAIL_FROM_NAME=QS Global Solutions Website
MAIL_TO=info@qs-global-solutions.com            # where form submissions are delivered
# CONTACT_MAIL_TO=                              # optional override for the contact form
# CAREERS_MAIL_TO=                              # optional override for job applications
MAIL_SEND_CONFIRMATION=true                     # send a "we received your request" email to the visitor

# Option A — Microsoft Graph (OAuth 2.0, recommended)
# Azure Portal → Microsoft Entra ID → App registrations → New registration
# API permissions → Microsoft Graph → Application permissions → Mail.Send → Grant admin consent
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Option B — SMTP (smtp.office365.com, STARTTLS 587)
# SMTP_AUTH=login  → mailbox password (Microsoft is disabling Basic Auth for SMTP by default from late 2026)
# SMTP_AUTH=oauth2 → uses the Azure app above (needs SMTP.SendAsApp + Exchange service principal)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_AUTH=login
# SMTP_USER=info@qs-global-solutions.com
# SMTP_PASS=

# ─────────────────────────────────────────────────────────────
# Railway Storage Bucket (qsgs-media) — set on Railway as references:
#   S3_ENDPOINT=${{qsgs-media.ENDPOINT}}  S3_BUCKET=${{qsgs-media.BUCKET}}  S3_REGION=${{qsgs-media.REGION}}
#   S3_ACCESS_KEY_ID=${{qsgs-media.ACCESS_KEY_ID}}  S3_SECRET_ACCESS_KEY=${{qsgs-media.SECRET_ACCESS_KEY}}
# Without these locally, images are read from ./media-local/images and uploads are not stored.
# ─────────────────────────────────────────────────────────────
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_UPLOAD_TOKEN=   # 32+ random characters; enables PUT /api/admin/media/ for image uploads

# ── Search engines ──
# Google Search Console → Add property → HTML tag → copy only the content="…" value
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag → copy only the content="…" value
# BING_SITE_VERIFICATION=
